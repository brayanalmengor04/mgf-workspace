APP_NAME="MGF Workspace"
APP_BRAND="MGF Workspace"
APP_ENV=local
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=minimal
# GEMINI_TRANSLATE_FALLBACK=true
# Límites según AI Studio → Rate limits (ajusta a tu plan)
# GEMINI_RATE_LIMIT_RPM=15
# GEMINI_RATE_LIMIT_TPM=250000
# GEMINI_RATE_LIMIT_RPD=1500
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_TIMEOUT=15
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=contraseña_de_aplicacion_16_caracteres
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME="MGF Workspace"

# Portfolio equivalent: EMAIL_USER / EMAIL_PASS / EMAIL_TO

# Railway (producción) — Resend API (SMTP bloqueado en Railway)
# MAIL_MAILER=resend
# RESEND_API_KEY=
# MAIL_FROM_ADDRESS=onboarding@resend.dev

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SEO (sitio público)
SEO_SITE_NAME="${APP_BRAND}"
SEO_TITLE="Seguimiento Financiero Personal | ${APP_BRAND}"
SEO_DESCRIPTION="Plataforma de seguimiento financiero personal. Controla presupuestos, cotizaciones y tus finanzas con una herramienta flexible para uso personal y comercial."
SEO_KEYWORDS="seguimiento financiero, finanzas personales, presupuestos, cotizaciones, gestión financiera"
SEO_IMAGE=assets/graphs/web/opengraphs.png
SEO_TWITTER_CARD=summary_large_image
SEO_OG_TYPE=website
SEO_ROBOTS_INDEX=true
SEO_ROBOTS_FOLLOW=true
